# ── Authentication ────────────────────────────────────────────────────────────
# App-only bearer token: fastest path for read-only, public data.
X_BEARER_TOKEN=

# OAuth 2.0 user context (recommended for posting, DMs, bookmarks).
# Run `npx x-mcp auth` to obtain these with a browser-based PKCE flow.
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
# Space separated scopes requested by `x-mcp auth` (defaults are minimal).
X_OAUTH2_SCOPE=

# OAuth 1.0a user context (classic API key & access token).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Block every write tool (posting, liking, following, DMs, ...).
X_MCP_READ_ONLY=false
# Show the HTTP request a write tool would make instead of sending it.
X_MCP_DRY_RUN=false
# in-memory response cache for idempotent GETs: on | off
X_MCP_CACHE=on
X_MCP_CACHE_TTL_MS=30000
X_MCP_CACHE_MAX=512
# HTTP
X_MCP_TIMEOUT_MS=20000
X_MCP_MAX_RETRIES=2
X_MCP_RATE_LIMIT_MODE=wait   # wait | fail
X_MCP_MAX_WAIT_MS=60000
# Tool exposure: allow-list and deny-list of toolsets (posts, timelines, users,
# engagement, lists, spaces, trends, dms, media, meta)
X_MCP_TOOLSETS=
X_MCP_DISABLE_TOOLSETS=
X_MCP_MAX_OUTPUT_CHARS=60000
X_MCP_LOG_LEVEL=info        # trace | debug | info | warn | error | silent

# ── Media viewing (x_get_media) ──────────────────────────────────────────────
# ffmpeg enables video/GIF frame extraction; leave empty to auto-detect.
X_MCP_FFMPEG=
X_MCP_MAX_VIDEO_MB=200
X_MCP_MAX_IMAGE_MB=15
X_MCP_FRAME_WIDTH=1280
# Test-only: allow http:// and private hosts for media downloads.
X_MCP_MEDIA_ALLOW_PRIVATE=false
# Directories allowed for path-based uploads (platform path separator).
X_MCP_MEDIA_ROOTS=
# Optional HTTP transport: `x-mcp serve --http 3333`
X_MCP_HTTP_PORT=3333
X_MCP_HTTP_HOST=127.0.0.1
# Require `Authorization: Bearer <token>` on /mcp. Mandatory for non-loopback binds.
X_MCP_HTTP_TOKEN=
# Comma-separated browser origins allowed via CORS (or *). Empty = no CORS.
X_MCP_HTTP_CORS=
# Override for tests or self-hosted gateways (defaults: https://api.x.com)
X_API_BASE=
X_UPLOAD_BASE=
# OAuth 2.0 callback used by `x-mcp auth` (must be registered in the X app).
X_OAUTH2_REDIRECT_URI=http://127.0.0.1:8787/callback
